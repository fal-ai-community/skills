{
  "version": 1,
  "stages": [
    {
      "id": "transcript",
      "endpoint": "fal-ai/elevenlabs/speech-to-text/scribe-v2",
      "inputs": {
        "audio_url": "REPLACE_SOURCE_AUDIO_URL",
        "diarize": false,
        "tag_audio_events": false
      },
      "async": true
    },
    {
      "id": "dub",
      "endpoint": "fal-ai/elevenlabs/dubbing",
      "inputs": {
        "video_url": "REPLACE_SOURCE_VIDEO_URL",
        "target_lang": "REPLACE_TARGET_LANGUAGE_CODE"
      },
      "async": true
    }
  ]
}
