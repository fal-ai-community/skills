FAL_KEY=your_fal_key_here

# HuggingFace repo ID for a FLUX-compatible IP-Adapter
IP_ADAPTER_PATH=XLabs-AI/flux-ip-adapter

# Must match the image encoder used by IP_ADAPTER_PATH
IP_ENCODER_PATH=openai/clip-vit-large-patch14

# Optional tuning — defaults shown
IP_ADAPTER_SCALE=0.7
CONTROLNET_SCALE=0.7
CONTROL_MODE=depth
